    "%@ gaf een onleesbaar antwoord. Probeer het opnieuw.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat eine unlesbare Antwort geliefert. Versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ returned an unreadable response. Try again."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gaf een onleesbaar antwoord. Probeer het opnieuw."
          }
        }
      }
    },
    "%@ heeft tijdelijk te veel aanvragen. Probeer het over een moment opnieuw.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ erhält vorübergehend zu viele Anfragen. Versuchen Sie es gleich noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is temporarily receiving too many requests. Try again in a moment."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ heeft tijdelijk te veel aanvragen. Probeer het over een moment opnieuw."
