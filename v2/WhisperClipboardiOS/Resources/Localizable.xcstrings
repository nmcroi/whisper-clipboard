    "AI staat per vergadering opnieuw standaard uit. Alleen transcripttekst gaat naar %@, nooit audio.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI ist für jede Besprechung standardmäßig aus. Nur Transkripttext wird an %@ gesendet, niemals Audio."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI is off by default for every meeting. Only transcript text is sent to %@, never audio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "AI staat per vergadering opnieuw standaard uit. Alleen transcripttekst gaat naar %@, nooit audio."
          }
        }
      }
    },
