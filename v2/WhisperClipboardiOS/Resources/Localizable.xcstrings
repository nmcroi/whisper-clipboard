    "Er is een ander iCloud-account aangemeld. Voeg de %lld lokale items alleen samen als deze geschiedenis bij dat account mag horen. Er wordt niets lokaal verwijderd.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderes iCloud-Konto ist angemeldet. Führen Sie die %lld lokalen Einträge nur zusammen, wenn dieser Verlauf zu diesem Konto gehören darf. Lokal wird nichts gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A different iCloud account is signed in. Merge the %lld local items only if this history may belong to that account. Nothing will be deleted locally."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is een ander iCloud-account aangemeld. Voeg de %lld lokale items alleen samen als deze geschiedenis bij dat account mag horen. Er wordt niets lokaal verwijderd."
          }
        }
      }
    },
