    "WhisperClip transcribeert volledig op je iPhone. Download eenmalig het meertalige Parakeet-model (~460 MB). Daarna werkt alles offline.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "WhisperClip transkribiert vollständig auf Ihrem iPhone. Laden Sie einmalig das mehrsprachige Parakeet-Modell (~460 MB) herunter. Danach funktioniert alles offline."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WhisperClip transcribes entirely on your iPhone. Download the multilingual Parakeet model once (~460 MB). Everything then works offline."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "WhisperClip transcribeert volledig op je iPhone. Download eenmalig het meertalige Parakeet-model (~460 MB). Daarna werkt alles offline."
          }
        }
      }
