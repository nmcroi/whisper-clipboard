    "Controleer elk voorstel. Alleen wat jij toevoegt komt in de woordenlijst.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen Sie jeden Vorschlag. Nur von Ihnen hinzugefügte Einträge kommen ins Wörterbuch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review every suggestion. Only items you add are placed in the dictionary."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer elk voorstel. Alleen wat jij toevoegt komt in de woordenlijst."
          }
        }
      }
    },
    "Corrigeer woorden die de spraakherkenning vaak verkeerd verstaat. Elk woord links wordt overal vervangen door de tekst rechts — hele woorden, hoofdletterongevoelig. Bijvoorbeeld: ‘klot’ → ‘Claude’.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Korrigieren Sie Wörter, die die Spracherkennung häufig falsch versteht. Jedes Wort links wird überall durch den Text rechts ersetzt — nur ganze Wörter, ohne Beachtung der Großschreibung. Zum Beispiel: ‚Clod‘ → ‚Claude‘."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Correct words that speech recognition often mishears. Each word on the left is replaced everywhere by the text on the right — whole words, case-insensitive. For example: ‘clod’ → ‘Claude’."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrigeer woorden die de spraakherkenning vaak verkeerd verstaat. Elk woord links wordt overal vervangen door de tekst rechts — hele woorden, hoofdletterongevoelig. Bijvoorbeeld: ‘klot’ → ‘Claude’."
          }
        }
      }
    },
    "Dag": {
      "localizations": {
