    "Je Claude API-key is ongeldig of geweigerd. Controleer de sleutel in Instellingen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Claude-API-Schlüssel ist ungültig oder wurde abgelehnt. Prüfen Sie den Schlüssel in den Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
