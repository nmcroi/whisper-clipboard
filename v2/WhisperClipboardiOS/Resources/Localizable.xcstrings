    "‘Dit ben ik’ wordt bij een nieuwe notulenopname alvast geselecteerd. De lijst synchroniseert met je Mac via iCloud.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Das bin ich“ wird bei einer neuen Protokollaufnahme vorausgewählt. Die Liste wird über iCloud mit Ihrem Mac synchronisiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "‘This is me’ is preselected for a new minutes recording. The list syncs with your Mac through iCloud."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘Dit ben ik’ wordt bij een nieuwe notulenopname alvast geselecteerd. De lijst synchroniseert met je Mac via iCloud."
          }
        }
      }
    },
