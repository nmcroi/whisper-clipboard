    "De %lld bestaande lokale items worden samengevoegd met dit iCloud-account. Er wordt niets lokaal verwijderd.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die %lld vorhandenen lokalen Einträge werden mit diesem iCloud-Konto zusammengeführt. Lokal wird nichts gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The %lld existing local items will be merged with this iCloud account. Nothing will be deleted locally."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De %lld bestaande lokale items worden samengevoegd met dit iCloud-account. Er wordt niets lokaal verwijderd."
          }
        }
      }
    },
    "De AI-aanbieder vond geen betrouwbare woordenlijstsuggesties in deze transcriptie.": {
