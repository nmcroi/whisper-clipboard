    "Bewaart je gesynchroniseerde geschiedenis, notities, woordenlijst en vaste deelnemers in je persoonlijke iCloud en houdt WhisperClip op je iPhone en Mac gelijk.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert den synchronisierten Verlauf, Notizen, das Wörterbuch und feste Teilnehmer in Ihrer persönlichen iCloud und hält WhisperClip auf iPhone und Mac synchron."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stores your synced history, notes, dictionary and saved participants in your personal iCloud and keeps WhisperClip in sync on your iPhone and Mac."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaart je gesynchroniseerde geschiedenis, notities, woordenlijst en vaste deelnemers in je persoonlijke iCloud en houdt WhisperClip op je iPhone en Mac gelijk."
          }
