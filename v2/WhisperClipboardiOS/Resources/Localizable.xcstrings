    "Bij iedere AI-opdracht wordt zichtbaar welke aanbieder en welk model de gekozen transcripttekst ontvangen. Audio wordt nooit verstuurd.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei jeder KI-Aufgabe wird angezeigt, welcher Anbieter und welches Modell den ausgewählten Transkripttext erhalten. Audio wird niemals gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every AI task shows which provider and model receive the selected transcript text. Audio is never sent."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij iedere AI-opdracht wordt zichtbaar welke aanbieder en welk model de gekozen transcripttekst ontvangen. Audio wordt nooit verstuurd."
          }
        }
      }
    },
