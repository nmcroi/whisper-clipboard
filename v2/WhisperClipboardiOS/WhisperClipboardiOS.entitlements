<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iCloud CloudKit for cross-device history sync (i2). CKSyncEngine uses the
	     private database in this container. The container id matches the Mac app
	     so both platforms sync into the same private zone. -->
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.nl.nielscroiset.whisperclipboard</string>
	</array>
</dict>
</plist>
