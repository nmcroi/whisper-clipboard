<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iCloud CloudKit for cross-device history sync (i2). CKSyncEngine uses the
	     private database in this container. The container id matches the Mac app
	     so both platforms sync into the same private zone. -->
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.nl.nielscroiset.whisperclipboard</string>
	</array>
	<!-- iCloud key-value store voor de woordenlijst-sync (ReplacementsCloudSync).
	     BEWUST dezelfde identifier als de Mac-app (dus NIET het eigen bundle-id
	     met .ios-suffix): apps delen alleen één KV-store wanneer de identifier
	     exact gelijk is. Portal: zet "iCloud key-value storage" aan op beide
	     App IDs. Zonder entitlement/account degradeert de sync stil (geen crash). -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)nl.nielscroiset.whisperclipboard</string>
</dict>
</plist>
